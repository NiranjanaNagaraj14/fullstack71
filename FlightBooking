import React from "react";

export default function FlightBooking() {
  const bookTicket = () => {
    // Step 1: Get user name
    const name = prompt("Enter your name:");
    if (!name) {
      alert("Booking cancelled! Name is required.");
      return;
    }

    // Step 2: Get destination
    const destination = prompt("Enter your destination:");
    if (!destination) {
      alert("Booking cancelled! Destination is required.");
      return;
    }

    // Step 3: Get number of tickets
    const tickets = prompt("Enter number of tickets:");
    if (!tickets || isNaN(tickets)) {
      alert("Invalid ticket count!");
      return;
    }

    // Step 4: Confirm booking
    const confirmBooking = confirm(
      `Please confirm your booking:\n\nName: ${name}\nDestination: ${destination}\nTickets: ${tickets}`
    );

    if (confirmBooking) {
      alert(`✈️ Booking Successful!\n\nHappy Journey, ${name}!`);
    } else {
      alert("Booking Cancelled.");
    }
  };

  return (
    <>
      {/* Google Font */}
      <style>
        {`
          @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&display=swap');

          body {
            margin: 0;
            font-family: 'Playfair Display', serif;
          }
        `}
      </style>

      <div style={styles.container}>
        <div style={styles.card}>
          <h2 style={styles.heading}>Flight Ticket Booking</h2>
          <p style={styles.text}>
            Book your flight easily using interactive dialog boxes.
          </p>

          <button style={styles.button} onClick={bookTicket}>
            ✈️ Book Ticket
          </button>
        </div>
      </div>
    </>
  );
}

const styles = {
  container: {
    minHeight: "100vh",
    backgroundColor: "#0A1A2F", // Navy
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
  },
  card: {
    backgroundColor: "#ffffff",
    padding: "35px",
    width: "420px",
    borderRadius: "14px",
    textAlign: "center",
    boxShadow: "0 12px 30px rgba(0,0,0,0.35)",
  },
  heading: {
    color: "#0A1A2F",
    marginBottom: "10px",
  },
  text: {
    color: "#333",
    marginBottom: "25px",
    fontSize: "15px",
  },
  button: {
    padding: "14px 28px",
    fontSize: "16px",
    backgroundColor: "#0A1A2F",
    color: "#D4AF37", // Gold
    border: "none",
    borderRadius: "8px",
    cursor: "pointer",
  },
};
