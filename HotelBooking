import React from "react";

export default function HotelBooking() {
  const reserveRoom = () => {
    // Step 1: Get customer name
    const name = prompt("Enter your name:");
    if (!name) {
      alert("Reservation cancelled! Name is required.");
      return;
    }

    // Step 2: Get room type
    const roomType = prompt("Enter room type (Single / Double / Deluxe):");
    if (!roomType) {
      alert("Room type is required!");
      return;
    }

    // Step 3: Get number of days
    const days = prompt("Enter number of days to stay:");
    if (!days || isNaN(days)) {
      alert("Invalid number of days!");
      return;
    }

    // Step 4: Confirmation
    const confirmBooking = confirm(
      `Please confirm your reservation:\n\nName: ${name}\nRoom Type: ${roomType}\nDays: ${days}`
    );

    if (confirmBooking) {
      alert(
        `🏨 Reservation Confirmed!\n\nThank you ${name}.\nEnjoy your stay in our ${roomType} room.`
      );
    } else {
      alert("Reservation Cancelled.");
    }
  };

  return (
    <>
      {/* Google Font */}
      <style>
        {`
          @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&display=swap');

          body {
            margin: 0;
            font-family: 'Playfair Display', serif;
          }
        `}
      </style>

      <div style={styles.container}>
        <div style={styles.card}>
          <h2 style={styles.heading}>Hotel Reservation System</h2>
          <p style={styles.text}>
            Reserve your room easily using interactive dialog boxes.
          </p>

          <button style={styles.button} onClick={reserveRoom}>
            🏨 Reserve Room
          </button>
        </div>
      </div>
    </>
  );
}

const styles = {
  container: {
    minHeight: "100vh",
    backgroundColor: "#0A1A2F", // Navy
    display: "flex",
    justifyContent: "center",
    alignItems: "center",
  },
  card: {
    backgroundColor: "#ffffff",
    padding: "35px",
    width: "420px",
    borderRadius: "14px",
    textAlign: "center",
    boxShadow: "0 12px 30px rgba(0,0,0,0.35)",
  },
  heading: {
    color: "#0A1A2F",
    marginBottom: "10px",
  },
  text: {
    color: "#333",
    marginBottom: "25px",
    fontSize: "15px",
  },
  button: {
    padding: "14px 28px",
    fontSize: "16px",
    backgroundColor: "#0A1A2F",
    color: "#D4AF37", // Gold
    border: "none",
    borderRadius: "8px",
    cursor: "pointer",
  },
};
